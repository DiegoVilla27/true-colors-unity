    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Congratulations! You've published your first Unity project. \n\nIf there's anything you want to change about your web game, just re-build and re-publish it to make updates. \n\nIf you want, share the Unity Play link with others so they play it and see what you've created."
