  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: "<b>1.</b>  At the bottom of the <b>Build Profiles</b> window, select <b>Build.</b>\n\nThis will open a file explorer asking you where you want to save your build. \n\n<b>2.</b>  Enter a name for your build, such as \"[YourFirstName] web build\", then select <b>Save</b>.\n\n<b>3.</b>  Wait for your build to complete.\n\n<b>Note:</b> This first time your project builds can take up to ten minutes. Subsequent builds will not take as long.\n"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
