--- !u!114 &-8596644215762414294
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Visual effects (VFX) are simulated motion effects added to enhance a scene, ranging from a subtle splash of water to a massive fiery explosion.\n\nUnity has tools to create visual effects and particles that can simulate fire, gas, rain, snow, and many other phenomena. \n\nWe've prepared some ready-to-use visual effects for your scene. \n\nAdd them to your scene for dramatic effect!\n"
--- !u!114 &-7817629285068887024
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Congratulations! You just completed your first game in Unity. \n\nIn the next optional tutorial, you'll learn how to upload your project to <b>Unity Play</b> so that you can experience it in a web browser.  \n\nAfter you upload your game, you can choose to make it private, only viewable with a link, or publicly available.\n\nThis way, you can easily share your Unity creations with friends, family, and the wider Unity community. Sharing your game is a fun way to showcase your creativity and also get feedback from others."
--- !u!114 &-7817182207079835133
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "You\u2019ve probably already noticed the shadows and reflections that come from the simulated sun, controlled by the <b>Directional Light</b> GameObject.\n\nUnity has many tools for simulating light and lighting effects. \n\nYou can now access the secret room, but it\u2019s quite dark inside. Let\u2019s add some lights to make the star stand out more."
