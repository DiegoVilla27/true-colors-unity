  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "By opening this template from the Unity Hub, you've created a Unity project.<br><br>In Unity, a <b>project</b> is the collection of artwork, models, scripts, and other assets you'll use to create an application, such as a playable game. \n\nThe <b>Project</b> window (highlighted now) lets you use and organize these files.<br><br>We've organized the files you'll use in this project in the <b>Assets</b> folder and its subfolders. "
