--- !u!114 &420936040809961908
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "A <b>player character</b> represents the user (the person playing your game) in the game world. \n\nWe've provided a <b>PlayerRobot</b> GameObject that you can use as the player character.\n\nLet's add the robot to the scene."
--- !u!114 &2583806235278472451
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: INSTRUCTIONS
  Text:
    m_Untranslated: '<b>1</b>.  In the <b>Project</b> window, open the <b>Assets</b> > <b>Prefabs</b> folder.


      <b>Important</b>: Single-click, don''t double-click, <b>PlayerRobot</b> (<a href="https://learn.unity.com/tutorial/671be8afedbc2a0105a17c0e#671bf065edbc2a0105919b3b">Help</a>).


      <b>2</b>.  Drag the <b>PlayerRobot</b> asset from the <b>Project</b> window into the <b>Scene</b> view and onto the white ground in your scene.'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
--- !u!114 &2623934242993170193
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "This is the <b>Hierarchy</b> window.\n\nThe <b>Hierarchy</b> window lists the GameObjects in your scene and helps you organize them.\n\n<b>GameObjects</b> are the things in your scene. \n\nMany GameObjects represent physical objects, but they can also be lights, sounds, visual effects, and more."
